rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 기본 차단: 명시적으로 허용된 규칙만 접근 가능
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── users 컬렉션 ─────────────────────────────────────────────────────
    // 경로: users/{uid}
    //
    // 읽기: 인증된 모든 사용자 허용
    //   → 점포 멤버 정보 조회 시 다른 멤버의 user 문서를 읽어야 하므로 완화
    // 쓰기: 자신의 문서만 허용
    //   → 탈퇴(softDeleteUser), 닉네임 수정, 복구 등 본인 작업만 가능
    //
    // TODO: 점포 공유 멤버만 서로의 문서를 읽도록 규칙 강화 검토
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // 점포 멤버 관리(승인/역할변경/추방/점포삭제) 시 관리자가 대상 멤버 문서의
      // storeById 캐시를 갱신/삭제해야 하므로 완화.
      // - storeById/updatedAt 외 필드(email, name, deletedAt 등)는 여전히 본인만 쓸 수 있음
      // - storeById는 role/color/name의 "캐시"일 뿐이며, 실제 점포 접근 권한 판정은 항상
      //   stores/{storeId}.memberById를 직접 조회하여 이뤄지므로(위 reservations 규칙 참고)
      //   이 필드를 위변조해도 곧바로 권한 상승으로 이어지지 않음
      // TODO: Firestore Rules는 Map diff에서 바뀐 키(어느 storeId인지)를 프로그래밍적으로
      //   추출할 수 없어 "그 storeId의 ADMIN인지"까지는 검증하지 못한다 — 정밀 검증이
      //   필요해지면 클라이언트가 대상 storeId를 별도 스칼라 필드로 함께 써서 Rules가
      //   직접 대조하도록 리팩터링 검토 (approveMember/updateMemberRole/removeMember/
      //   softDeleteStore에서 사용)
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeById', 'updatedAt']);
    }

    // ─── users 하위 private 서브컬렉션 ─────────────────────────────────────
    // 경로: users/{uid}/private/{docId}
    //
    // users/{uid} 본문은 멤버 이름 표시를 위해 인증 사용자 전체에 열려 있어,
    // FCM 토큰처럼 본인만 알아야 하는 값을 둘 수 없다. 기기 상관·핑거프린팅을
    // 막기 위해 토큰은 이 서브컬렉션으로 옮기고 본인만 접근하도록 한다.
    // Cloud Functions는 Admin SDK라 이 규칙을 우회한다.
    match /users/{uid}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── stores 컬렉션 ───────────────────────────────────────────────────
    // 경로: stores/{storeId}
    //
    // 읽기: 해당 점포의 멤버만 허용
    //   → 계좌 정보·멤버 목록·초대 코드가 담긴 문서이므로 최소 권한을 적용한다
    //   → 아직 멤버가 아닌 사용자의 초대 코드 조회는 Callable 함수
    //      lookupInviteCode가 대신한다 (functions/src/invite/). 표시에 필요한
    //      최소 정보만 반환하므로 문서를 통째로 열 필요가 없다
    // 생성: 생성자 본인이 memberById에 ADMIN으로 포함된 문서만 허용
    //   → 타인을 ADMIN으로 넣거나 memberById 없이 문서를 만드는 것을 막는다
    //      (UseCase(createStore)도 이미 생성자를 ADMIN으로 강제하므로 앱 동작에는
    //      영향이 없다)
    // 수정/삭제: ADMIN 역할 보유자만 허용
    match /stores/{storeId} {
      function isAdmin() {
        return request.auth != null
            && request.auth.uid in resource.data.memberById
            && resource.data.memberById[request.auth.uid].role == 'ADMIN';
      }

      function isMember() {
        return request.auth != null
            && request.auth.uid in resource.data.memberById;
      }

      // create 시점엔 기존 문서가 없으므로 resource.data가 아니라 들어오는 문서인
      // request.resource.data를 검사해야 한다(isAdmin()은 재사용 불가).
      function isCreatorAdmin() {
        return request.auth != null
            && 'memberById' in request.resource.data
            && request.auth.uid in request.resource.data.memberById
            && request.resource.data.memberById[request.auth.uid].role == 'ADMIN'
            // 생성자 외의 멤버를 끼워넣지 못하게 한다. 타인을 멤버로 넣은 뒤
            // users의 storeById 완화 규칙으로 캐시를 밀어넣으면 피해자 앱에
            // 유령 점포가 뜬다. 앱은 생성 시 항상 생성자 1명만 쓴다.
            && request.resource.data.memberById.keys().hasOnly([request.auth.uid]);
      }

      allow read:   if isMember();
      allow create: if isCreatorAdmin();
      allow update, delete: if isAdmin();

      // 가입 신청(requestJoinWithBatch): 아직 멤버가 아닌 인증된 사용자가 스스로를
      // waitingMemberById에 추가하는 것은 허용한다. isAdmin()은 이미 memberById에
      // 속한 사용자만 통과하므로, 신청자 본인은 별도 규칙이 필요하다.
      // - waitingMemberById/updatedAt 외 필드는 건드릴 수 없음
      // - waitingMemberById 안에서도 본인(request.auth.uid) 항목만 바꿀 수 있음
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitingMemberById', 'updatedAt'])
          && resource.data.waitingMemberById.diff(request.resource.data.waitingMemberById)
              .affectedKeys().hasOnly([request.auth.uid]);

      // ─── reservations 서브컬렉션 ─────────────────────────────────────
      // 경로: stores/{storeId}/reservations/{reservationId}
      //
      // 읽기: 해당 점포의 멤버(ADMIN, STAFF, VIEWER)만 허용
      // 쓰기: ADMIN 또는 STAFF만 허용 (VIEWER는 읽기 전용)
      //
      // NOTE: get()으로 상위 stores 문서를 읽으므로 읽기 1회 추가 과금
      match /reservations/{reservationId} {
        function storeMembers() {
          return get(/databases/$(database)/documents/stores/$(storeId)).data.memberById;
        }

        function memberRole() {
          return storeMembers()[request.auth.uid].role;
        }

        function isStoreMember() {
          return request.auth != null
              && request.auth.uid in storeMembers();
        }

        function isStaffOrAbove() {
          return isStoreMember()
              && memberRole() in ['ADMIN', 'STAFF'];
        }

        allow read:  if isStoreMember();
        allow write: if isStaffOrAbove();
      }
    }

    // ─── system 컬렉션 (서버 시각 동기화 전용) ──────────────────────────────
    // 경로: system/serverTime
    //
    // 클라이언트 기기 시각은 조작되거나 부정확할 수 있어 초대 코드 만료 검증 등에
    // 그대로 신뢰할 수 없다. FieldValue.serverTimestamp()를 기록한 뒤 즉시
    // 서버에서 재조회하는 왕복 조회(round-trip)로 신뢰 가능한 "현재 시각"을 얻기
    // 위한 스크래치 문서이다.
    //
    // probe 필드는 반드시 실제 서버 시각(request.time)과 정확히 일치해야만 쓰기가
    // 허용되므로, 다른 사용자가 임의의(미래/과거) 시각 값을 주입해 다른 사람의
    // 초대 코드 만료 판정을 조작하는 것이 불가능하다 — 모든 성공한 쓰기는
    // "진짜 현재 시각"만 담을 수 있다.
    // TODO: 모든 사용자가 문서 하나를 공유하므로 동시 요청이 잦아지면 Firestore의
    //   문서당 쓰기 속도 제한에 걸릴 수 있다 — 트래픽이 늘면 사용자별 분산(예:
    //   system/serverTime/probes/{uid}) 검토
    match /system/serverTime {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && request.resource.data.probe == request.time;
    }
  }
}
