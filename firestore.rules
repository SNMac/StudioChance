rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 기본 차단: 명시적으로 허용된 규칙만 접근 가능
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── users 컬렉션 ─────────────────────────────────────────────────────
    // 경로: users/{uid}
    //
    // 읽기: 인증된 모든 사용자 허용
    //   → 점포 멤버 정보 조회 시 다른 멤버의 user 문서를 읽어야 하므로 완화
    // 쓰기: 자신의 문서만 허용
    //   → 계정 삭제(markAccountDeleted), 닉네임 수정 등 본인 작업만 가능
    //
    // TODO: 점포 공유 멤버만 서로의 문서를 읽도록 규칙 강화 검토
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // 점포 멤버 관리(승인/역할변경/추방/점포삭제) 시 관리자가 대상 멤버 문서의
      // storeById 캐시를 갱신/삭제해야 하므로 완화.
      // - storeById/updatedAt 외 필드(email, name, deletedAt 등)는 여전히 본인만 쓸 수 있음
      // - storeById는 role/color/name의 "캐시"일 뿐이며, 실제 점포 접근 권한 판정은 항상
      //   stores/{storeId}.memberById를 직접 조회하여 이뤄지므로(위 reservations 규칙 참고)
      //   이 필드를 위변조해도 곧바로 권한 상승으로 이어지지 않음
      // TODO: Firestore Rules는 Map diff에서 바뀐 키(어느 storeId인지)를 프로그래밍적으로
      //   추출할 수 없어 "그 storeId의 ADMIN인지"까지는 검증하지 못한다 — 정밀 검증이
      //   필요해지면 클라이언트가 대상 storeId를 별도 스칼라 필드로 함께 써서 Rules가
      //   직접 대조하도록 리팩터링 검토 (approveMember/updateMemberRole/removeMember/
      //   softDeleteStore에서 사용)
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeById', 'updatedAt']);
    }

    // ─── users 하위 private 서브컬렉션 ─────────────────────────────────────
    // 경로: users/{uid}/private/{docId}
    //
    // users/{uid} 본문은 멤버 이름 표시를 위해 인증 사용자 전체에 열려 있어,
    // FCM 토큰처럼 본인만 알아야 하는 값을 둘 수 없다. 기기 상관·핑거프린팅을
    // 막기 위해 토큰은 이 서브컬렉션으로 옮기고 본인만 접근하도록 한다.
    // Cloud Functions는 Admin SDK라 이 규칙을 우회한다.
    match /users/{uid}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── stores 컬렉션 ───────────────────────────────────────────────────
    // 경로: stores/{storeId}
    //
    // 읽기: 해당 점포의 멤버만 허용 (D11)
    //   → 계좌 정보·멤버 목록·초대 코드가 담긴 문서이므로 최소 권한을 적용한다
    //   → 아직 멤버가 아닌 사용자의 초대 코드 조회는 Callable 함수
    //      lookupInviteCode가 대신한다 (functions/src/invite/). 표시에 필요한
    //      최소 정보만 반환하므로 문서를 통째로 열 필요가 없다
    // 생성: 생성자 본인이 memberById에 ADMIN으로 포함된 문서만 허용
    //   → memberById가 없거나, 생성자 외의 멤버가 끼어 있으면 막는다
    //      (역할 불문 — STAFF로 끼워넣는 것도 거부된다)
    //      (UseCase(createStore)도 이미 생성자를 ADMIN으로 강제하므로 앱 동작에는
    //      영향이 없다)
    // 수정/삭제: ADMIN 역할 보유자만 허용
    //   → 수정 후에도 ADMIN이 정확히 1명이어야 한다 (ADR-0004)
    // 초대 코드(inviteInfo): 클라이언트는 생성·수정 모두 null로만 쓸 수 있다 (ADR-0006)
    //   → 발급은 Callable issueInviteCode가 서버 시각으로 한다. 클라이언트가 쓸 수 있으면
    //      ADMIN이 발급 시각을 미래로 적어 유효 시간을 늘릴 수 있다
    //   → null 쓰기는 softDeleteStore 경로다
    match /stores/{storeId} {
      function isAdmin() {
        return request.auth != null
            && request.auth.uid in resource.data.memberById
            && resource.data.memberById[request.auth.uid].role == 'ADMIN';
      }

      function isMember() {
        return request.auth != null
            && request.auth.uid in resource.data.memberById;
      }

      // create 시점엔 기존 문서가 없으므로 resource.data가 아니라 들어오는 문서인
      // request.resource.data를 검사해야 한다(isAdmin()은 재사용 불가).
      function isCreatorAdmin() {
        return request.auth != null
            && 'memberById' in request.resource.data
            && request.auth.uid in request.resource.data.memberById
            && request.resource.data.memberById[request.auth.uid].role == 'ADMIN'
            // 생성자 외의 멤버를 끼워넣지 못하게 한다. 타인을 멤버로 넣은 뒤
            // users의 storeById 완화 규칙으로 캐시를 밀어넣으면 피해자 앱에
            // 유령 점포가 뜬다. 앱은 생성 시 항상 생성자 1명만 쓴다.
            && request.resource.data.memberById.keys().hasOnly([request.auth.uid]);
      }

      // 점포의 ADMIN 수. Rules는 맵 값을 순회할 수 없으므로 {'role': 'ADMIN'}을 모두
      // 지운 목록과의 크기 차이로 센다 (ADR-0004).
      // 멤버 값이 정확히 {role} 하나라는 전제에 기댄다 — StoreMemberInfoModel에 필드가
      // 늘면 관리자가 0명으로 세져 관리자의 모든 수정이 거부된다 (stores.test.ts가 고정)
      function adminCountOf(members) {
        return members.values().size()
            - members.values().removeAll([{'role': 'ADMIN'}]).size();
      }

      // 필드를 지운 경우도 null과 같이 본다
      function inviteInfoCleared() {
        return request.resource.data.get('inviteInfo', null) == null;
      }

      function affectedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // 삭제 예정 점포 (ADR-0007). 읽기 전용이며 점포 복구·영구 삭제·점포 나가기만 남는다
      function scheduledForDeletion() {
        return resource.data.get('deletedAt', null) != null;
      }

      // 7일은 lib/constants/data_constants.dart의 storeSoftDeleteDays와 같아야 한다.
      // 남은 기간은 서버 시각인 deletedAt 기준이다. expiresAt은 TTL용이라 기한으로 쓰지 않는다
      function restoreWindowOpen() {
        return request.time < resource.data.deletedAt + duration.value(7, 'd');
      }

      // 점포 삭제 쓰기 모양 (softDeleteStore)
      // - expiresAt은 기기 시각에 하루 여유를 더해 쓴다(현재 + 8일). 기기 시계가 하루 안쪽으로
      //   틀려도 TTL이 화면에 보인 기한(deletedAt + 7일)보다 먼저 지우지 않게 하려는 것이다
      // - 승인 대기 중인 신청은 이때 모두 정리한다. 멤버 목록은 바꿀 수 없다
      function isValidStoreDeletion() {
        return affectedKeys().hasOnly(
                ['deletedAt', 'expiresAt', 'inviteInfo', 'waitingMemberById', 'updatedAt'])
            && request.resource.data.deletedAt == request.time
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt >= request.time + duration.value(7, 'd')
            && request.resource.data.expiresAt <= request.time + duration.value(9, 'd')
            && inviteInfoCleared()
            && request.resource.data.get('waitingMemberById', {}).size() == 0;
      }

      // 점포 복구 쓰기 모양 (restoreStore): 삭제 표시 두 필드를 지우는 것 말고는 바꿀 수 없다
      function isValidStoreRestore() {
        return affectedKeys().hasOnly(['deletedAt', 'expiresAt', 'updatedAt'])
            && !('deletedAt' in request.resource.data)
            && !('expiresAt' in request.resource.data);
      }

      allow read:   if isMember();
      allow create: if isCreatorAdmin() && inviteInfoCleared();
      // 승인·역할 변경·추방·관리자 위임·점포 정보 수정이 모두 이 규칙을 거친다.
      // ADMIN으로 승인·승격, 관리자 강등·본인 추방은 관리자 수가 1이 아니게 되어 거부된다.
      // 삭제 예정 점포에서는 막고, 삭제 표시 필드는 아래 두 규칙으로만 바꾼다
      allow update: if isAdmin()
          && !scheduledForDeletion()
          && !affectedKeys().hasAny(['deletedAt', 'expiresAt'])
          && adminCountOf(request.resource.data.memberById) == 1
          && (!('inviteInfo' in affectedKeys()) || inviteInfoCleared());
      // 점포 삭제: 삭제 예정 점포로 만든다
      allow update: if isAdmin() && !scheduledForDeletion() && isValidStoreDeletion();
      // 점포 복구: 관리자만, 기한 안에만
      allow update: if isAdmin()
          && scheduledForDeletion()
          && restoreWindowOpen()
          && isValidStoreRestore();
      // 영구 삭제와 계정 삭제의 점포 정리. 지우면 cascadeStoreDelete가 예약까지 지운다
      allow delete: if isAdmin();

      // 가입 신청·신청 취소(requestJoinWithBatch, cancelJoinRequest): 아직 멤버가 아닌
      // 인증된 사용자가 waitingMemberById의 본인 항목을 추가하거나 지우는 것은 허용한다.
      // isAdmin()은 이미 memberById에 속한 사용자만 통과하므로 별도 규칙이 필요하다.
      // - waitingMemberById/updatedAt 외 필드는 건드릴 수 없음
      // - waitingMemberById 안에서도 본인(request.auth.uid) 항목만 바꿀 수 있음
      // - 신청 항목이 남는다면(추가) ADMIN 역할일 수 없고, 이미 멤버인 사람은 신청할 수 없음.
      //   삭제 예정 점포에는 신청할 수 없다. 항목이 사라지는 신청 취소는 그대로 허용한다
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitingMemberById', 'updatedAt'])
          && resource.data.waitingMemberById.diff(request.resource.data.waitingMemberById)
              .affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.waitingMemberById)
              || (request.resource.data.waitingMemberById[request.auth.uid].role != 'ADMIN'
                  && !(request.auth.uid in resource.data.memberById)
                  && !scheduledForDeletion()));

      // 점포 나가기(leaveStore): 멤버가 memberById의 본인 항목을 지우는 것은 허용한다.
      // 키가 본인 uid로 정해져 있어 "관리자는 나갈 수 없다"를 여기서 직접 검증한다
      // (관리자는 위임하거나 점포를 삭제해야 한다)
      allow update: if request.auth != null
          && request.auth.uid in resource.data.memberById
          && resource.data.memberById[request.auth.uid].role != 'ADMIN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberById', 'updatedAt'])
          && resource.data.memberById.diff(request.resource.data.memberById)
              .affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.memberById);

      // ─── reservations 서브컬렉션 ─────────────────────────────────────
      // 경로: stores/{storeId}/reservations/{reservationId}
      //
      // 읽기: 해당 점포의 멤버(ADMIN, STAFF, VIEWER)만 허용
      // 쓰기: ADMIN 또는 STAFF만 허용 (VIEWER는 읽기 전용). 삭제 예정 점포에서는 막는다 (ADR-0007)
      //
      // NOTE: get()으로 상위 stores 문서를 읽으므로 읽기 1회 추가 과금
      // (같은 요청 안의 같은 문서 get()은 한 번만 과금된다)
      match /reservations/{reservationId} {
        function storeData() {
          return get(/databases/$(database)/documents/stores/$(storeId)).data;
        }

        function storeMembers() {
          return storeData().memberById;
        }

        function memberRole() {
          return storeMembers()[request.auth.uid].role;
        }

        function isStoreMember() {
          return request.auth != null
              && request.auth.uid in storeMembers();
        }

        function isStaffOrAbove() {
          return isStoreMember()
              && memberRole() in ['ADMIN', 'STAFF'];
        }

        allow read:  if isStoreMember();
        allow write: if isStaffOrAbove() && storeData().get('deletedAt', null) == null;
      }
    }

    // ─── holidays 컬렉션 (공휴일 달력) ──────────────────────────────────────
    // 경로: holidays/{year}
    //
    // 읽기: 인증된 모든 사용자 허용 — 예약 가격 계산에 필요한 공개 정보
    // 쓰기: 금지 — Cloud Functions(syncHolidays, Admin SDK)만 쓴다 (ADR-0001)
    match /holidays/{year} {
      allow read: if request.auth != null;
    }
  }
}
